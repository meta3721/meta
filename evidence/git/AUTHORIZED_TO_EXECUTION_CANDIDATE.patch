+def package_zip(
+    root: Path,
+    preflight_path: Path,
+    preflight_md: Path,
+    md_path: Path,
+    docx_path: Path,
+    readme: Path,
+    git_dir: Path,
+) -> Path:
+    zip_path = root / "deliverables/RAVEN_MCS_E1_FORMAL_EVIDENCE.zip"
+    include_dirs = [
+        root / "configs/frozen",
+        root / "outputs/event_traces",
+        root / "outputs/audits",
+        root / "outputs/evidence_formal_r1",
+        root / "logs",
