+
+def test_frozen_manifest_detects_modified_file() -> None:
+    source = (
+        ROOT / "scripts/verify_frozen_config_manifest.py"
+    ).read_text(encoding="utf-8")
+    assert "actual == meta[\"sha256\"]" in source
+
+
